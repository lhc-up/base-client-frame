BC_LOCALHOST=127.0.0.1
BC_PORT=8099

BC_API_CONTEXT=/wj/api
BC_PAGE_CONTEXT=/wj

# key
BC_HEADER_AUTHORIZATION=Authorization
BC_STORAGE_KEY_TOKEN=questionaire-auth-token
BC_STORAGE_KEY_PROJECT_LIST=questionaire-project-list
BC_STORAGE_KEY_PREFIX_ANSWER=answer-result-id

# business
BC_BIZ_INTERACTIVE_CONTEXT=jhcp

# cdn
# 注入web端的js文件路径后缀
BC_INJECT_JS_PATH_SUFFIX_WEB=injectJsForWeb.js
# 注入客户端的js文件路径后缀
BC_INJECT_JS_PATH_SUFFIX_CLIENT=injectJsForElectron.js
