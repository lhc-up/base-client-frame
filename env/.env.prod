# 当前运行（代理）环境
BC_ENV=prod
BC_ENV_NAME=正式版

# 代理地址，支持代理到不同的服务，但需要把web页面所在域名放到第一位，启用在线版时会用到
BC_PROXY=[["/wj/api", "https://eachina.changyan.cn"]]

# cdn
# 预加载配置文件地址
BC_PRE_FETCH_CONFIG_URL=https://eachinaoss.liyunedu.cn/eachina-answer/master/cache/config.json
# 注入作答端的js文件路径前缀
BC_INJECT_JS_PATH_PREFIX=https://eachinaoss.liyunedu.cn/eachina-answer/master/client
