{
    "name": "@base-client/frame",
    "version": "0.0.1",
    "description": "Electron 客户端工程化构建框架",
    "type": "commonjs",
    "main": "src/index.js",
    "exports": {
        ".": "./src/index.js",
        "./paths": "./src/paths.js",
        "./package.json": "./package.json"
    },
    "bin": {
        "base-client": "./bin/base-client.js"
    },
    "private": false,
    "author": "lhc-up",
    "license": "ISC",
    "engines": {
        "node": "^20.19.0 || ^22.13.0 || >=24"
    },
    "keywords": [
        "electron",
        "electron-builder",
        "bytenode",
        "webpack",
        "build",
        "packager",
        "cli"
    ],
    "scripts": {
        "lint": "eslint bin src/paths.js src/core/node-version.js",
        "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
        "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
        "prepublishOnly": "npm test"
    },
    "peerDependencies": {
        "bytenode": "^1.4.0",
        "electron": ">=22.0.0",
        "webpack": "^5.0.0",
        "webpack-dev-server": "^5.0.0"
    },
    "peerDependenciesMeta": {
        "bytenode": {
            "optional": true
        },
        "electron": {
            "optional": true
        }
    },
    "devDependencies": {
        "eslint": "^10.15.0",
        "eslint-plugin-n": "^18.5.0",
        "html-webpack-plugin": "^5.6.3",
        "jest": "^30.4.2",
        "webpack": "^5.107.2",
        "webpack-dev-server": "^5.2.4"
    },
    "dependencies": {
        "@base-client/electron-builder": "24.13.3-bc.1",
        "@electron/asar": "^3.4.1",
        "cac": "^6.7.14",
        "dotenv": "^17.4.2",
        "fs-extra": "^11.3.5",
        "jimp": "^0.22.12",
        "ora": "^5.4.1",
        "picocolors": "^1.1.1",
        "png2icons": "^2.0.1",
        "webpack-merge": "^6.0.1"
    },
    "files": [
        "bin",
        "src"
    ]
}
